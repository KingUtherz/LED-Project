<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>LED Banner Prototype</title>
<style>
  :root {
    --ui-bg: #0a0c0f;
    --ui-card: #14181d;
    --ui-card-2: #1b2027;
    --ui-line: #262d36;
    --ui-text: #e8edf3;
    --ui-muted: #8b96a5;
    --ui-accent: #4cc9f0;
    --ui-accent-ink: #04141a;
    --radius: 14px;
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  html, body {
    margin: 0;
    height: 100%;
    background: var(--ui-bg);
    color: var(--ui-text);
    font-family: system-ui, -apple-system, "Segoe UI", "Noto Sans Thai", "Sarabun", Tahoma, sans-serif;
    overflow: hidden;
  }

  /* ---------- Layout ---------- */
  .app {
    height: 100vh;
    height: 100dvh;
    display: grid;
    grid-template-rows: minmax(160px, 38%) 1fr;
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 12px;
    padding-left: max(12px, env(safe-area-inset-left));
    padding-right: max(12px, env(safe-area-inset-right));
    padding-bottom: max(12px, env(safe-area-inset-bottom));
  }

  /* Landscape: display on the left, control panel on the right */
  @media (orientation: landscape) and (min-width: 560px) {
    .app {
      grid-template-rows: 1fr;
      grid-template-columns: minmax(0, 1fr) clamp(300px, 36vw, 400px);
    }
  }

  /* ---------- Display ---------- */
  .display-wrap { position: relative; min-height: 0; min-width: 0; }

  .display {
    position: absolute;
    inset: 0;
    background: var(--bg, #000);
    color: var(--fg, #39ff14);
    border-radius: var(--radius);
    border: 1px solid var(--ui-line);
    overflow: hidden;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.02em;
    font-family: system-ui, "Noto Sans Thai", "Sarabun", Tahoma, Arial, sans-serif;
    box-shadow: inset 0 0 40px rgba(0,0,0,.55);
  }

  .display.glow .marquee,
  .display.glow .static-inner {
    text-shadow: 0 0 .06em currentColor, 0 0 .2em currentColor;
  }

  .marquee {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .track {
    display: flex;
    flex: none;
    width: max-content;
    will-change: transform;
  }

  .group { display: flex; flex: none; }

  .item {
    flex: none;
    white-space: pre;
    padding-inline-end: 1.6em; /* gap between repeated messages */
  }

  .static {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 4%;
    overflow: hidden;
  }

  .static-inner {
    display: block;
    max-width: 100%;
    line-height: 1.1;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .display.mode-scroll .marquee { display: flex; }
  .display:not(.mode-scroll) .marquee { display: none; }
  .display:not(.mode-scroll) .static { display: flex; }

  .display.mode-blink .static {
    animation: blink var(--blink, 1s) infinite;
  }
  @keyframes blink {
    0%, 49%   { opacity: 1; }
    50%, 100% { opacity: .03; }
  }

  /* LED dot-matrix overlay */
  .led-mask {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: none;
    background-image: radial-gradient(circle at center, transparent 0 36%, var(--bg, #000) 64%);
    background-size: var(--dot, 8px) var(--dot, 8px);
    opacity: .9;
  }
  .display.dots .led-mask { display: block; }

  /* Overlay buttons on the display */
  .overlay-btns {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    gap: 8px;
    z-index: 3;
  }
  .icon-btn {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(10,12,15,.6);
    color: #fff;
    font-size: 18px;
    cursor: pointer;
    display: grid;
    place-items: center;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: .55;
    transition: opacity .2s, transform .1s;
  }
  .icon-btn:hover, .icon-btn:focus-visible { opacity: 1; }
  .icon-btn:active { transform: scale(.94); }
  .icon-btn[hidden] { display: none; }

  /* ---------- Immersive (display only) ---------- */
  .app.immersive {
    grid-template-rows: 1fr;
    grid-template-columns: 1fr;
    padding: 0;
    gap: 0;
  }
  .app.immersive .panel { display: none; }
  .app.immersive .display { border-radius: 0; border: 0; }

  /* ---------- Control Panel ---------- */
  .panel {
    min-height: 0;
    min-width: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--ui-card);
    border: 1px solid var(--ui-line);
    border-radius: var(--radius);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    -webkit-overflow-scrolling: touch;
  }

  .panel-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .04em;
    margin: 0;
  }
  .panel-title i {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--ui-accent);
    box-shadow: 0 0 10px var(--ui-accent);
  }

  .field { display: flex; flex-direction: column; gap: 8px; }
  .field > label, .field > .label {
    font-size: 12px;
    color: var(--ui-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
    letter-spacing: .03em;
  }
  .field output { color: var(--ui-text); font-variant-numeric: tabular-nums; }

  .text-row { display: flex; gap: 8px; }

  input[type="text"] {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--ui-line);
    background: var(--ui-card-2);
    color: var(--ui-text);
    font-size: 16px; /* prevents iOS zoom */
    font-family: inherit;
    outline: none;
  }
  input[type="text"]:focus { border-color: var(--ui-accent); }

  .btn {
    min-height: 44px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--ui-line);
    background: var(--ui-card-2);
    color: var(--ui-text);
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    transition: background .15s, border-color .15s, transform .1s;
  }
  .btn:hover { border-color: #3a4552; }
  .btn:active { transform: scale(.97); }
  .btn:focus-visible, .icon-btn:focus-visible, .swatch:focus-visible {
    outline: 2px solid var(--ui-accent);
    outline-offset: 2px;
  }

  /* Segmented control */
  .seg {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 4px;
    padding: 4px;
    background: var(--ui-card-2);
    border: 1px solid var(--ui-line);
    border-radius: 14px;
  }
  .seg .btn { border: 0; background: transparent; color: var(--ui-muted); min-height: 42px; }
  .seg .btn[aria-pressed="true"] {
    background: var(--ui-accent);
    color: var(--ui-accent-ink);
    font-weight: 700;
  }
  .seg .btn:disabled { opacity: .35; cursor: not-allowed; }

  input[type="range"] {
    width: 100%;
    height: 32px;
    accent-color: var(--ui-accent);
    background: transparent;
    cursor: pointer;
  }

  .color-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .color-box {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: var(--ui-card-2);
    border: 1px solid var(--ui-line);
    border-radius: 12px;
    font-size: 13px;
    color: var(--ui-muted);
  }
  input[type="color"] {
    width: 44px; height: 44px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    cursor: pointer;
    flex: none;
  }
  input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
  input[type="color"]::-webkit-color-swatch { border: 1px solid var(--ui-line); border-radius: 10px; }
  input[type="color"]::-moz-color-swatch { border: 1px solid var(--ui-line); border-radius: 10px; }

  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(48px, 1fr)); gap: 8px; }
  .swatch {
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--ui-line);
    font-weight: 800;
    font-size: 16px;
    cursor: pointer;
    font-family: inherit;
  }
  .swatch:active { transform: scale(.94); }

  /* Toggle switch */
  .toggles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 48px;
    padding: 0 12px;
    background: var(--ui-card-2);
    border: 1px solid var(--ui-line);
    border-radius: 12px;
    color: var(--ui-text);
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
  }
  .toggle .knob {
    width: 38px; height: 22px;
    border-radius: 11px;
    background: #38414d;
    position: relative;
    flex: none;
    transition: background .2s;
  }
  .toggle .knob::after {
    content: "";
    position: absolute;
    top: 3px; left: 3px;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: #fff;
    transition: transform .2s;
  }
  .toggle[aria-pressed="true"] .knob { background: var(--ui-accent); }
  .toggle[aria-pressed="true"] .knob::after { transform: translateX(16px); }

  /* Compact phones */
  @media (max-width: 380px) {
    .color-grid, .toggles { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn, .icon-btn, .knob, .knob::after { transition: none; }
  }
</style>
</head>
<body>
<div class="app" id="app">

  <!-- ===== Display Screen ===== -->
  <section class="display-wrap" aria-label="หน้าจอป้ายไฟ LED">
    <div class="display mode-scroll dots glow" id="display">
      <div class="marquee"><div class="track" id="track"></div></div>
      <div class="static"><span class="static-inner" id="staticInner"></span></div>
      <div class="led-mask"></div>
    </div>
    <div class="overlay-btns">
      <button class="icon-btn" id="pauseBtn" type="button" aria-label="หยุด/เล่นการเลื่อน" title="หยุด/เล่น">⏸</button>
      <button class="icon-btn" id="immersiveBtn" type="button" aria-label="สลับโหมดเต็มจอ" title="เต็มจอ">⛶</button>
    </div>
  </section>

  <!-- ===== Control Panel ===== -->
  <aside class="panel" aria-label="แผงควบคุม">
    <h1 class="panel-title"><i></i>LED BANNER</h1>

    <div class="field">
      <label for="textInput">ข้อความ</label>
      <div class="text-row">
        <input type="text" id="textInput" maxlength="200" placeholder="พิมพ์ข้อความของคุณ..." autocomplete="off">
        <button class="btn" id="clearBtn" type="button" aria-label="ล้างข้อความ">ล้าง</button>
      </div>
    </div>

    <div class="field">
      <span class="label">โหมดการแสดงผล</span>
      <div class="seg" id="modeSeg" role="group" aria-label="โหมดการแสดงผล">
        <button class="btn" type="button" data-value="scroll" aria-pressed="true">เลื่อน</button>
        <button class="btn" type="button" data-value="static" aria-pressed="false">หยุดนิ่ง</button>
        <button class="btn" type="button" data-value="blink" aria-pressed="false">กะพริบ</button>
      </div>
    </div>

    <div class="field">
      <span class="label">ทิศทางการเลื่อน</span>
      <div class="seg" id="dirSeg" role="group" aria-label="ทิศทางการเลื่อน">
        <button class="btn" type="button" data-value="left" aria-pressed="true">← ซ้าย</button>
        <button class="btn" type="button" data-value="right" aria-pressed="false">ขวา →</button>
      </div>
    </div>

    <div class="field">
      <label for="speedRange">ความเร็ว <output id="speedOut">160</output></label>
      <input type="range" id="speedRange" min="20" max="800" step="10" value="160">
    </div>

    <div class="field">
      <label for="sizeRange">ขนาดตัวอักษร <output id="sizeOut">60%</output></label>
      <input type="range" id="sizeRange" min="20" max="95" step="1" value="60">
    </div>

    <div class="field">
      <span class="label">สี</span>
      <div class="color-grid">
        <label class="color-box"><input type="color" id="fgColor" value="#39ff14" aria-label="สีตัวอักษร">ตัวอักษร</label>
        <label class="color-box"><input type="color" id="bgColor" value="#000000" aria-label="สีพื้นหลัง">พื้นหลัง</label>
      </div>
    </div>

    <div class="field">
      <span class="label">ชุดสีสำเร็จรูป</span>
      <div class="swatches" id="swatches"></div>
    </div>

    <div class="toggles">
      <button class="toggle" id="dotsToggle" type="button" aria-pressed="true">จุด LED <span class="knob"></span></button>
      <button class="toggle" id="glowToggle" type="button" aria-pressed="true">เรืองแสง <span class="knob"></span></button>
    </div>
  </aside>
</div>

<script>
(function () {
  'use strict';

  /* ---------- State ---------- */
  var state = {
    text: 'ยินดีต้อนรับ ✦ LED BANNER ✦ Welcome',
    mode: 'scroll',   // scroll | static | blink
    dir: 'left',      // left | right
    speed: 160,       // px per second
    size: 60,         // % of display height
    fg: '#39ff14',
    bg: '#000000',
    dots: true,
    glow: true,
    paused: false,
    immersive: false
  };

  var PRESETS = [
    { fg: '#39ff14', bg: '#000000', name: 'เขียวนีออน' },
    { fg: '#ff2d2d', bg: '#000000', name: 'แดง' },
    { fg: '#ffb000', bg: '#000000', name: 'เหลืองอำพัน' },
    { fg: '#00e5ff', bg: '#000000', name: 'ฟ้าไซยาน' },
    { fg: '#ff4df0', bg: '#12001a', name: 'ชมพูนีออน' },
    { fg: '#ffffff', bg: '#0a2a8a', name: 'ขาวบนน้ำเงิน' },
    { fg: '#000000', bg: '#ffe600', name: 'ดำบนเหลือง' },
    { fg: '#ffffff', bg: '#000000', name: 'ขาวดำ' }
  ];

  /* ---------- Elements ---------- */
  var $ = function (id) { return document.getElementById(id); };
  var app = $('app');
  var display = $('display');
  var track = $('track');
  var staticInner = $('staticInner');
  var textInput = $('textInput');
  var speedRange = $('speedRange');
  var sizeRange = $('sizeRange');
  var speedOut = $('speedOut');
  var sizeOut = $('sizeOut');
  var fgColor = $('fgColor');
  var bgColor = $('bgColor');
  var pauseBtn = $('pauseBtn');
  var immersiveBtn = $('immersiveBtn');

  /* Marquee runtime values */
  var offsetX = 0;     // current scroll offset within one group
  var groupW = 0;      // width of one repeated group
  var lastTs = 0;

  /* ---------- Helpers ---------- */
  function displayText() {
    return state.text.trim() ? state.text : 'พิมพ์ข้อความ...';
  }

  /* Apply colors / effects / base font size */
  function applyStyles() {
    var h = display.clientHeight || 120;
    display.style.setProperty('--fg', state.fg);
    display.style.setProperty('--bg', state.bg);
    display.style.setProperty('--dot', Math.max(4, Math.min(12, Math.round(h / 36))) + 'px');
    display.style.fontSize = Math.round(h * state.size / 100) + 'px';
    display.classList.toggle('dots', state.dots);
    display.classList.toggle('glow', state.glow);
    display.classList.remove('mode-scroll', 'mode-static', 'mode-blink');
    display.classList.add('mode-' + state.mode);
    // Blink interval follows the speed slider (faster = quicker blink)
    var blink = Math.min(2.4, Math.max(0.25, 1.2 / (state.speed / 160)));
    display.style.setProperty('--blink', blink.toFixed(2) + 's');
  }

  /* Build the infinite marquee: one group >= viewport width, duplicated twice */
  function buildMarquee() {
    track.textContent = '';
    var group = document.createElement('div');
    group.className = 'group';

    var item = document.createElement('span');
    item.className = 'item';
    item.textContent = displayText();
    group.appendChild(item);
    track.appendChild(group);

    var itemW = Math.max(1, item.getBoundingClientRect().width);
    var copies = Math.max(1, Math.ceil(display.clientWidth / itemW));
    for (var i = 1; i < copies; i++) {
      var c = item.cloneNode(true);
      group.appendChild(c);
    }

    var clone = group.cloneNode(true);
    clone.setAttribute('aria-hidden', 'true');
    track.appendChild(clone);

    groupW = group.getBoundingClientRect().width;
    if (groupW > 0) offsetX = ((offsetX % groupW) + groupW) % groupW;
    track.style.transform = 'translate3d(' + (-offsetX) + 'px,0,0)';
  }

  /* Static / blink: shrink text until it fits the display */
  function buildStatic() {
    staticInner.textContent = displayText();
    staticInner.style.fontSize = '';
    var fs = parseFloat(getComputedStyle(staticInner).fontSize) || 40;
    var maxH = display.clientHeight * 0.96;
    var guard = 0;
    while (staticInner.offsetHeight > maxH && fs > 10 && guard < 40) {
      fs *= 0.92;
      staticInner.style.fontSize = fs.toFixed(1) + 'px';
      guard++;
    }
  }

  /* Rebuild whatever the current mode needs */
  function rebuild() {
    applyStyles();
    if (state.mode === 'scroll') {
      buildMarquee();
    } else {
      buildStatic();
    }
    pauseBtn.hidden = state.mode !== 'scroll';
    pauseBtn.textContent = state.paused ? '▶' : '⏸';
  }

  /* ---------- Animation loop (smooth speed changes, seamless wrap) ---------- */
  function frame(ts) {
    if (!lastTs) lastTs = ts;
    var dt = Math.min((ts - lastTs) / 1000, 0.1);
    lastTs = ts;

    if (state.mode === 'scroll' && !state.paused && groupW > 0) {
      var sign = state.dir === 'left' ? 1 : -1;
      offsetX += sign * state.speed * dt;
      offsetX = ((offsetX % groupW) + groupW) % groupW;
      track.style.transform = 'translate3d(' + (-offsetX).toFixed(2) + 'px,0,0)';
    }
    requestAnimationFrame(frame);
  }

  /* ---------- UI bindings ---------- */
  function bindSegment(container, key, onChange) {
    var buttons = container.querySelectorAll('button');
    function sync() {
      buttons.forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-value') === state[key]));
      });
    }
    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        state[key] = b.getAttribute('data-value');
        sync();
        onChange();
      });
    });
    sync();
  }

  function bindToggle(btn, key) {
    btn.addEventListener('click', function () {
      state[key] = !state[key];
      btn.setAttribute('aria-pressed', String(state[key]));
      applyStyles();
    });
  }

  function updateDirState() {
    var disabled = state.mode !== 'scroll';
    $('dirSeg').querySelectorAll('button').forEach(function (b) { b.disabled = disabled; });
  }

  function setColors(fg, bg) {
    state.fg = fg;
    state.bg = bg;
    fgColor.value = fg;
    bgColor.value = bg;
    applyStyles();
  }

  /* Text */
  textInput.value = state.text;
  textInput.addEventListener('input', function () {
    state.text = textInput.value;
    rebuild();
  });
  $('clearBtn').addEventListener('click', function () {
    textInput.value = '';
    state.text = '';
    rebuild();
    textInput.focus();
  });

  /* Mode & direction */
  bindSegment($('modeSeg'), 'mode', function () {
    updateDirState();
    rebuild();
  });
  bindSegment($('dirSeg'), 'dir', function () { /* handled live by the loop */ });
  updateDirState();

  /* Speed & size */
  speedRange.addEventListener('input', function () {
    state.speed = Number(speedRange.value);
    speedOut.textContent = state.speed;
    applyStyles();
  });
  sizeRange.addEventListener('input', function () {
    state.size = Number(sizeRange.value);
    sizeOut.textContent = state.size + '%';
    rebuild();
  });

  /* Colors */
  fgColor.addEventListener('input', function () { state.fg = fgColor.value; applyStyles(); });
  bgColor.addEventListener('input', function () { state.bg = bgColor.value; applyStyles(); });

  /* Presets */
  var swatchBox = $('swatches');
  PRESETS.forEach(function (p) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'swatch';
    b.textContent = 'A';
    b.style.color = p.fg;
    b.style.background = p.bg;
    b.setAttribute('aria-label', 'ชุดสี ' + p.name);
    b.title = p.name;
    b.addEventListener('click', function () { setColors(p.fg, p.bg); });
    swatchBox.appendChild(b);
  });

  /* Toggles */
  bindToggle($('dotsToggle'), 'dots');
  bindToggle($('glowToggle'), 'glow');

  /* Pause / play */
  pauseBtn.addEventListener('click', function () {
    state.paused = !state.paused;
    pauseBtn.textContent = state.paused ? '▶' : '⏸';
  });

  /* Immersive mode (hide panel; Fullscreen API is attempted but optional) */
  function setImmersive(on) {
    state.immersive = on;
    app.classList.toggle('immersive', on);
    immersiveBtn.textContent = on ? '✕' : '⛶';
    try {
      if (on && document.fullscreenEnabled && !document.fullscreenElement) {
        var p = document.documentElement.requestFullscreen();
        if (p && p.catch) p.catch(function () { /* not permitted in sandbox: CSS mode still works */ });
      } else if (!on && document.fullscreenElement) {
        document.exitFullscreen();
      }
    } catch (e) { /* ignore */ }
  }
  immersiveBtn.addEventListener('click', function () { setImmersive(!state.immersive); });
  document.addEventListener('fullscreenchange', function () {
    if (!document.fullscreenElement && state.immersive) setImmersive(false);
  });

  /* ---------- Resize / orientation handling ---------- */
  var resizeQueued = false;
  function queueRebuild() {
    if (resizeQueued) return;
    resizeQueued = true;
    requestAnimationFrame(function () {
      resizeQueued = false;
      rebuild();
    });
  }
  if (typeof ResizeObserver !== 'undefined') {
    new ResizeObserver(queueRebuild).observe(display);
  } else {
    window.addEventListener('resize', queueRebuild);
  }
  window.addEventListener('orientationchange', queueRebuild);

  /* ---------- Init ---------- */
  rebuild();
  requestAnimationFrame(frame);

  // Re-measure after fonts are ready so widths are accurate
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(rebuild).catch(function () {});
  }
})();
</script>
